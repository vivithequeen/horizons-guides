---
import Default from '@astrojs/starlight/components/PageTitle.astro';

const { id } = Astro.locals.starlightRoute;
const isGuide = id.startsWith('guides/');
const slug = id.split('/').pop();
---

{isGuide && <p class="guide-eyebrow">Hack Club</p>}
<Default><slot /></Default>
{
	isGuide && (
		<a class="pdf-download" href={`/pdfs/${slug}.pdf`} download={`${slug}.pdf`}>
			<svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
				<path d="M12 3v12" />
				<path d="m7 10 5 5 5-5" />
				<path d="M5 21h14" />
			</svg>
			Download
		</a>
	)
}

<style>
	.guide-eyebrow {
		margin-top: 1rem;
		font-family: 'Cook Widetype', 'Bricolage Grotesque', system-ui, sans-serif;
		font-size: var(--sl-text-sm);
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: #ec3750;
	}
	.guide-eyebrow + :global(h1) {
		margin-top: 0.25rem;
	}
	.pdf-download {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 0.5rem;
		width: 50%;
		margin-top: 1.25rem;
		padding: 0.125rem 1rem;
		font-family: 'Cook Widetype', 'Bricolage Grotesque', system-ui, sans-serif;
		font-size: var(--sl-text-base);
		letter-spacing: 0.02em;
		text-transform: uppercase;
		text-decoration: none;
		color: #fff;
		background-color: #ec3750;
		border: 3px solid var(--hz-frame);
		border-radius: 1rem;
		box-shadow: 0 4px 0 var(--hz-frame);
		transition: transform 0.1s ease, box-shadow 0.1s ease;
	}
	.pdf-download:hover {
		transform: translateY(-2px);
		box-shadow: 0 6px 0 var(--hz-frame);
	}
	.pdf-download:active {
		transform: translateY(2px);
		box-shadow: 0 2px 0 var(--hz-frame);
	}
	.pdf-download:focus-visible {
		outline: 3px solid var(--sl-color-accent-high);
		outline-offset: 3px;
	}
	@media print {
		.pdf-download {
			display: none;
		}
	}
</style>
